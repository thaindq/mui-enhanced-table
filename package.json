  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prebuild": "npm run clean",
    "build": "parcel build",
    "start": "npm run storybook",
    "clean": "rimraf dist && mkdir dist",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint {src,tests,stories}/**/*.{ts,tsx} --fix",
    "format": "prettier --write {src,stories,tests}/**/*.{ts,tsx}",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaindq/mui-enhanced-table.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thaindq/mui-enhanced-table/issues"
  },
  "homepage": "https://github.com/thaindq/mui-enhanced-table#readme",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@react-hookz/web": "^25.1.1",
    "clsx": "^2.1.1",
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@faker-js/faker": "^9.8.0",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@parcel/packager-ts": "^2.15.2",
    "@parcel/transformer-typescript-types": "^2.15.2",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-storysource": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/lodash-es": "^4.17.12",
