{
  "name": "mui-enhanced-table",
  "version": "0.6.0",
  "description": "",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "targets": {
    "main": {
      "optimize": true
    },
    "module": {
      "optimize": true
